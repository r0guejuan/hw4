# Copy to .env and fill in real values. Never commit .env.

# All AI calls are routed through Portkey
PORTKEY_API_KEY=your-portkey-api-key-here
PORTKEY_BASE_URL=https://api.portkey.ai/v1
# Only needed for direct OpenAI calls (not used when routing through Portkey)
OPENAI_API_KEY=your-openai-api-key-here

# Model tiers. Note: through Portkey, the gpt-6.1-* names are served as gpt-5.6-luna,
# so use the names below to get the models you expect.
# Hard agent steps (multi-step reasoning, tool orchestration)
OPENAI_MODEL_HARD=gpt-6-sol
OPENAI_MODEL_HARD_ALT=gpt-6-astra
# Simple tasks (short replies, classification, formatting)
OPENAI_MODEL=gpt-5.6-luna
OPENAI_MODEL_SIMPLE_ALT=gpt-5.6-terra

# Local data pack (relative to backend/)
DATABASE_PATH=../data/campus_customs.db
PRODUCTS_DIR=../data/products

# Signs login session cookies. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=your-random-session-secret-here
# Set to true when the site is served over HTTPS
COOKIE_SECURE=false

# Encrypts stored (test) card numbers. Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CARD_ENCRYPTION_KEY=your-fernet-key-here
